cff-version: 1.2.0
message: "If you use this work, please cite it as below."
title: "MAG-S3 and MAG-S3b: recording the quantum compass, CISS non-reciprocity and cryptochrome order"
type: software
version: "0.2.0"
doi: "10.5281/zenodo.24079875"
identifiers:
  - type: doi
    value: "10.5281/zenodo.24043500"
    description: "Version 0.1.0 (MAG-S3)"
  - type: doi
    value: "10.5281/zenodo.24044654"
    description: "Version 0.1.1 (MAG-S3)"
repository-code: "https://github.com/nikabri88-cmd/quantum-compass-recording"
authors:
